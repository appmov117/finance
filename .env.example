# Conexión a Postgres (Supabase). Se acepta postgresql:// o postgresql+psycopg://
DATABASE_URL=
# Clave para firmar sesiones, mínimo 32 caracteres: openssl rand -hex 32
SECRET_KEY=
# Cuenta de administradora; se crea al iniciar si no existe
ADMIN_PHONE=
ADMIN_PIN=
ADMIN_NAME=Administradora
# Lugar de firma que aparece en los pagarés, por ejemplo: Mérida, Yucatán
CONTRACT_CITY=
# Correo de contacto del aviso de privacidad y los términos
CONTACT_EMAIL=
# Opcionales
TIMEZONE=America/Mexico_City
PORT=3000
